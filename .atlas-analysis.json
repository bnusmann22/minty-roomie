  "keyFeatures": [
    "Compatibility-based roommate discovery with lifestyle scoring",
    "Social feed for roommate request posts, reactions, and comments",
    "Consent-based Roommate Agreements with e-signature and payment gate",
    "Shared expense ledger with automatic bill splitting via Paystack",
    "Vetted student hostel catalog unlocked by confirmed roommate pairs",
    "Student identity verification with verified badge",
    "Secure real-time messaging with offline PWA caching",
    "Roomie ID — OAuth SSO for housing provider integrations",
    "Connection network mapping 1st/2nd-degree roommate relationships",
    "Earnable trust badges (Verified Student, Good Payer, Roomie Partner)",
    "Checkout Consent workflow for deposit release",
    "Push notifications for connection requests and agreement updates"
  ],
  "publicApiSurface": [
    "POST /v1/auth/login",
